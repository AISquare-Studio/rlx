{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorLoginOpenUrl",
  "description": "`connector.login.open_url`: `{login_id, id, url}`.",
  "type": "object",
  "properties": {
    "id": {
      "description": "The connector.",
      "type": "string",
      "minLength": 1
    },
    "login_id": {
      "description": "The login.",
      "type": "string",
      "minLength": 1
    },
    "url": {
      "description": "The URL to open, always `https://`.",
      "type": "string",
      "pattern": "^https://"
    }
  },
  "required": [
    "login_id",
    "id",
    "url"
  ]
}
