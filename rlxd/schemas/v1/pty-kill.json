{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PtyKillParams",
  "description": "`pty.kill`'s params.\n\n```json\n{\"pty_id\": \"6f1c2e0a9b8d4f3e2a1b0c9d8e7f6a5b\"}\n```",
  "type": "object",
  "properties": {
    "pty_id": {
      "description": "The PTY. Its process and every process in its group (on Windows, its job) end, and\nthe PTY is gone.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "required": [
    "pty_id"
  ]
}
