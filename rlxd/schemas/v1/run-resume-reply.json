{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunResumeData",
  "description": "`run.resume`'s reply: the run, and the attempt it is now on.",
  "type": "object",
  "properties": {
    "attempt": {
      "description": "Its new attempt, from 2.",
      "type": "integer",
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 2
    },
    "run_id": {
      "description": "The run.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "run_id",
    "attempt"
  ]
}
